# Copie para .env.staging e preencha somente localmente; .env.staging fica ignorado pelo Git.
# URL do pooler compartilhado do projeto staging; mantenha sslmode=require.
STAGING_DB_URL=jdbc:postgresql://<pooler-host-do-projeto-staging>:5432/postgres?sslmode=require
# Conexão direta: barber_runtime. Pooler compartilhado: barber_runtime.<project-ref>.
STAGING_DB_USERNAME=barber_runtime.<project-ref>
STAGING_DB_PASSWORD=
STAGING_JWT_SECRET=

STAGING_CORS_ALLOWED_ORIGINS=http://localhost:5173
STAGING_PASSWORD_RESET_URL=http://localhost:5173/redefinir-senha
STAGING_BOOTSTRAP_ADMIN_ENABLED=false
STAGING_NOTIFICACOES_RESEND_ATIVO=false
# Opcional para staging: manter desativado; remetente deve pertencer a domínio verificado.
STAGING_RESEND_API_KEY=
STAGING_RESEND_REMETENTE=
