# Copie este arquivo para .env e substitua as credenciais por valores locais fortes.

# Reutilize os mesmos valores ao iniciar a API fora do Docker.
DB_URL=jdbc:postgresql://db.yuktkjzkmacsverxwnmi.supabase.co:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=replace-with-supabase-database-password
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRATION=7200000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SERVER_PORT=8080
PASSWORD_RESET_URL=http://localhost:5173/redefinir-senha
PASSWORD_RESET_EXPIRATION_MINUTES=15

# Ative somente para criar o primeiro administrador no banco vazio.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_NOME=
BOOTSTRAP_ADMIN_TELEFONE=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# SMTP é necessário para enviar links de recuperação reais.
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
PASSWORD_RESET_FROM=no-reply@barbearia.local

# O envio externo permanece desativado até credenciais reais serem configuradas.
NOTIFICACOES_RESEND_ATIVO=false
RESEND_API_KEY=
RESEND_REMETENTE=
NOTIFICACOES_WHATSAPP_ATIVO=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_VERSION=
