# Copie este arquivo para .env e substitua as credenciais por valores locais fortes.

# Reutilize os mesmos valores ao iniciar a API fora do Docker.
# Runtime: use uma role PostgreSQL dedicada, nunca a role administrativa postgres.
DB_URL=jdbc:postgresql://db.abcdefghijklmnopqrst.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=barber_runtime
DB_PASSWORD=your-local-runtime-role-password
# Identificador público do projeto Supabase associado a esta implantação.
SUPABASE_PROJECT_REF=abcdefghijklmnopqrst
# Credencial barber_migrator: somente no ambiente isolado de migrations; nunca no ambiente da API.
JWT_SECRET=your-local-random-secret-at-least-32-bytes
JWT_EXPIRATION=900000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SERVER_PORT=8080
PASSWORD_RESET_URL=http://localhost:5173/redefinir-senha
PASSWORD_RESET_EXPIRATION_MINUTES=15

# Ative somente para criar o primeiro administrador no banco vazio.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_NOME=
BOOTSTRAP_ADMIN_TELEFONE=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

PASSWORD_RESET_URL=http://localhost:5173/redefinir-senha

# Desativado por padrão; habilite somente após configurar um remetente verificado.
NOTIFICACOES_RESEND_ATIVO=false
RESEND_API_KEY=
RESEND_REMETENTE=
